#include <stdio.h>

#define MAX 5

int queue[MAX];
int front = -1;
int rear = -1;

void enqueue(int value) {

    if(rear == MAX - 1)
        printf("Queue Overflow\n");

    else {

        if(front == -1)
            front = 0;

        queue[++rear] = value;

        printf("%d inserted\n", value);
    }
}

void dequeue() {

    if(front == -1 || front > rear)
        printf("Queue Underflow\n");

    else
        printf("%d deleted\n", queue[front++]);
}

void display() {

    int i;

    if(front == -1 || front > rear)
        printf("Queue Empty\n");

    else {

        printf("Queue Elements:\n");

        for(i = front; i <= rear; i++)
            printf("%d ", queue[i]);
    }
}

int main() {

    enqueue(10);
    enqueue(20);
    enqueue(30);

    display();

    printf("\n");

    dequeue();

    display();

    return 0;
}
